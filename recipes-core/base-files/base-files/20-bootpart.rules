# 1. Global SD card exclusion to prevent duplicate auto-mounting under /run/media
# ENV{mount_options}="ignore" explicitly flags udev-extraconf's script to skip this device
SUBSYSTEM=="block", KERNEL=="mmcblk1*", ENV{UDISKS_IGNORE}="1", ENV{mount_options}="ignore"

# 2. Try to match the active boot partition passed directly from the bootloader command line
IMPORT{cmdline}="rauc.slot"
ENV{rauc.slot}=="system0", KERNEL=="mmcblk[0-9]*p1", SYMLINK+="boot"
ENV{rauc.slot}=="system1", KERNEL=="mmcblk[0-9]*p2", SYMLINK+="boot"

# 3. Fallback to the native script ONLY if the command line attributes are missing
ENV{rauc.slot}=="", KERNEL=="mmcblk[0-9]*p[0-9]*", PROGRAM="@BINDIR@/isbootpart %k", SYMLINK+="boot"

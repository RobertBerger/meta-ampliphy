#!/bin/sh
# Target device partition passed via udev %k ($1)
TARGET_PART="$1"

if [ -z "$TARGET_PART" ]; then
    exit 1
fi

ROOT_DEV_RAW=$(tr ' ' '\n' < /proc/cmdline | grep '^root=' | cut -d= -f2)
if [ "$ROOT_DEV_RAW" = "/dev/root" ] || [ -z "$ROOT_DEV_RAW" ]; then
    ROOT_DEV_RAW=$(awk '$2 == "/" {print $1}' /proc/mounts)
fi

case "$ROOT_DEV_RAW" in
    /dev/mmcblk*) ROOT_DEV="$ROOT_DEV_RAW" ;;
    *) ROOT_DEV=$(readlink -f "$ROOT_DEV_RAW" 2>/dev/null) ;;
esac

case "$ROOT_DEV" in
    /dev/mmcblk*p5)
        BOOT_DISK="${ROOT_DEV#/dev/}"
        EXPECTED_BOOT_PART="${BOOT_DISK%p5}p1"
        ;;
    /dev/mmcblk*p6)
        BOOT_DISK="${ROOT_DEV#/dev/}"
        EXPECTED_BOOT_PART="${BOOT_DISK%p6}p2"
        ;;
    *)
        exit 1
        ;;
esac

if [ "$TARGET_PART" = "$EXPECTED_BOOT_PART" ]; then
    exit 0
fi

exit 1

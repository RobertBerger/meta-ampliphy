#!/bin/sh
# Target device partition passed via udev %k ($1)
TARGET_PART="$1"

if [ -z "$TARGET_PART" ]; then
    exit 1
fi

# STANDARD LOCAL STORAGE RESOLUTION FALLBACK
ROOT_DEV_RAW=$(tr ' ' '\n' < /proc/cmdline | grep '^root=' | cut -d= -f2)
if [ "$ROOT_DEV_RAW" = "/dev/root" ] || [ -z "$ROOT_DEV_RAW" ]; then
    ROOT_DEV_RAW=$(awk '$2 == "/" {print $1}' /proc/mounts)
fi

ROOT_DEV=$(readlink -f "$ROOT_DEV_RAW")
if ! echo "$ROOT_DEV" | grep -q "^/dev/"; then
    exit 1
fi

# Isolate parent storage nodes cleanly
BOOT_DISK=$(basename "$ROOT_DEV" | sed -E 's/p[0-9]+$//')
BOOT_PART_NUM=$(basename "$ROOT_DEV" | grep -o -E '[0-9]+$')

if [ -n "$BOOT_DISK" ] && [ -n "$BOOT_PART_NUM" ]; then
    # DYNAMIC TWIN-SLOT HARDWARE MATRIX MAP
    if [ "$BOOT_PART_NUM" = "5" ]; then
        EXPECTED_BOOT_PART="${BOOT_DISK}p1"   # Active root p5 -> companion boot p1
    elif [ "$BOOT_PART_NUM" = "6" ]; then
        EXPECTED_BOOT_PART="${BOOT_DISK}p2"   # Active root p6 -> companion boot p2
    else
        EXPECTED_BOOT_PART="${BOOT_DISK}p1"   # Default fallback
    fi

    if [ "$TARGET_PART" = "$EXPECTED_BOOT_PART" ]; then
        exit 0
    fi
fi

exit 1
